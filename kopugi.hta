<html><head><meta charset="utf-8"><title>커푸기</title>
<HTA:APPLICATION ID="k" APPLICATIONNAME="커푸기" SCROLL="no" SINGLEINSTANCE="yes" MAXIMIZEBUTTON="no"/>
<style>
body{margin:0;background:#15161a;font-family:"Malgun Gothic",sans-serif;color:#cfd2d8;text-align:center}
h4{font-weight:normal;margin:26px 0 18px;font-size:13px;color:#8a8f99}
.btn{display:inline-block;padding:14px 30px;border:2px solid #b8932f;border-radius:22px;background:#2a2412;color:#f1c84c;font-size:20px;font-weight:bold;cursor:pointer}
.btn:hover{background:#3a3115}
small{display:block;margin-top:6px;font-size:11px;color:#a08a45;font-weight:normal}
</style></head><body>
<h4>커밋 + 푸시 + 기록</h4>
<span class="btn" onclick="run()">커푸기<small>Commit · Push · Log</small></span>
<script>
function run(){
  var p=unescape(location.pathname).replace(/^\//,'').replace(/\//g,'\\');
  var dir=p.substring(0,p.lastIndexOf('\\'));
  new ActiveXObject("WScript.Shell").Run('powershell -NoExit -ExecutionPolicy Bypass -File "'+dir+'\\kopugi.ps1"',1,false);
}
window.resizeTo(300,190);
</script></body></html>